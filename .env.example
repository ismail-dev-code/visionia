# PostgreSQL connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct/session-mode PostgreSQL connection used by Prisma migrations and schema tools.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js secret. Replace with a unique, cryptographically random value.
AUTH_SECRET="replace-with-a-random-secret"

# Primary site origin used for SSLCommerz callbacks and exposed to the browser.
# Use your public HTTPS origin in production; localhost is suitable only for local development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Auth.js URL override and SSLCommerz callback fallback.
AUTH_URL="http://localhost:3000"

# Legacy URL fallback used by the SSLCommerz callback origin resolver.
NEXTAUTH_URL="http://localhost:3000"

# Optional server-side SSLCommerz merchant ID; set only when enabling payments.
SSLCOMMERZ_STORE_ID="replace-with-your-store-id"

# Optional server-side SSLCommerz merchant password; never expose it to client code.
SSLCOMMERZ_STORE_PASSWORD="replace-with-your-store-password"

# Must be exactly "true" for sandbox or "false" for live mode.
SSLCOMMERZ_IS_SANDBOX="true"

# Optional self-hosted build identifier, unique for each deployment.
NEXT_DEPLOYMENT_ID="replace-with-a-unique-deployment-id"

# Vercel provides this automatically. Leave empty on other hosts unless the app is deployed there.
VERCEL_DEPLOYMENT_ID=""

# Next.js/Node runtime mode. Next.js normally sets this automatically.
NODE_ENV="development"
