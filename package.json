{
  "name": "visionia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.15.0",
    "sonner": "^2.0.0",
    "sslcommerz-lts": "1.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^17.14.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.2",
      "sslcommerz-lts>form-data": "2.5.6"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "patchedDependencies": {
      "sslcommerz-lts@1.2.0": "patches/sslcommerz-lts@1.2.0.patch"
    }
  }
